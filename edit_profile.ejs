<% layout("/layouts/boilerplate") %>

<div class="rw-auth-wrapper">
    <div class="rw-auth-card">
        <div class="mb-4">
            <span class="eyebrow"><i class="bi bi-person-gear me-1"></i> Account Settings</span>
            <h2 class="display-title font-serif mb-2" style="font-size: 2.2rem;">Edit Profile</h2>
            <p class="text-secondary small mb-0">Update your public username across the ReWear platform.</p>
        </div>

        <form action="/profile?_method=PUT" method="POST">
            <div class="rw-input-group mb-4 text-start">
                <label class="rw-label">Username</label>
                <input type="text" name="username" value="<%= user.username %>" required class="rw-input">
            </div>

            <div class="d-flex flex-column gap-2">
                <button type="submit" class="rw-btn rw-btn-accent rw-btn-lg w-100 py-3">Save Profile</button>
                <a href="/dashboard" class="rw-btn rw-btn-outline rw-btn-sm w-100">Cancel</a>
            </div>
        </form>
    </div>
</div>
