<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Listing Approvals Queue | ReWear Admin Portal</title>
  <link href="https://cdn.jsdelivr.net/css?family=Inter:300,400,500,600,700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    :root {
      --admin-bg: #0B0F17;
      --admin-card: #151C28;
      --admin-border: #232D3F;
      --admin-accent: #E1A93C;
      --admin-text: #E2E8F0;
      --admin-muted: #94A3B8;
    }
    body { background-color: var(--admin-bg); color: var(--admin-text); font-family: 'Inter', sans-serif; }
    .admin-card { background: var(--admin-card); border: 1px solid var(--admin-border); border-radius: 12px; }
    .table-dark-custom { --bs-table-bg: var(--admin-card); --bs-table-border-color: var(--admin-border); color: var(--admin-text); }
  </style>
</head>
<body class="py-4 px-3 px-md-5">

  <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-3 border-secondary border-opacity-25">
    <div>
      <a href="/admin/dashboard" class="btn btn-sm btn-outline-secondary mb-2"><i class="bi bi-arrow-left me-1"></i> Back to Dashboard</a>
      <h2 class="h3 fw-bold mb-0 text-warning d-flex align-items-center gap-2">
        <i class="bi bi-shield-check"></i> Listing Approvals Queue
      </h2>
    </div>
    <div class="d-flex align-items-center gap-2">
      <a href="/admin/listings/review?status=pending" class="btn btn-sm <%= currentStatus === 'pending' ? 'btn-warning text-dark' : 'btn-outline-secondary' %>">Pending Review</a>
      <a href="/admin/listings/review?status=approved" class="btn btn-sm <%= currentStatus === 'approved' ? 'btn-success' : 'btn-outline-secondary' %>">Approved</a>
      <a href="/admin/listings/review?status=rejected" class="btn btn-sm <%= currentStatus === 'rejected' ? 'btn-danger' : 'btn-outline-secondary' %>">Rejected</a>
    </div>
  </div>

  <% if(listings && listings.length > 0) { %>
    <div class="admin-card p-3 table-responsive">
      <table class="table table-dark-custom align-middle mb-0">
        <thead>
          <tr class="text-uppercase small text-muted">
            <th>Garment</th>
            <th>Seller</th>
            <th>Category & Size</th>
            <th>AI Valuation</th>
            <th>AI Status</th>
            <th>Submitted At</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% for(let item of listings) { %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-3">
                  <img src="<%= item.frontImage?.url || item.image?.url %>" class="rounded-2 object-fit-cover" style="width: 48px; height: 48px;">
                  <div>
                    <div class="fw-bold text-light"><%= item.productName %></div>
                    <div class="small text-muted"><%= item.brand %></div>
                  </div>
                </div>
              </td>
              <td>
                <div class="small fw-medium">@<%= item.owner?.username || 'User' %></div>
                <div class="small text-muted"><%= item.owner?.email || '' %></div>
              </td>
              <td>
                <span class="badge bg-secondary"><%= item.category || item.itemType %></span>
                <span class="badge bg-outline-warning border border-warning text-warning ms-1"><%= item.size %></span>
              </td>
              <td>
                <div class="fw-bold text-warning">₹<%= (item.aiEvaluation?.estimatedValueINR || item.price || 0).toLocaleString() %></div>
                <div class="small text-success"><%= (item.aiEvaluation?.suggestedCredits || item.price || 0).toLocaleString() %> Credits</div>
              </td>
              <td>
                <% if(item.aiEvaluation?.informationMismatch) { %>
                  <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle-fill me-1"></i> Mismatch</span>
                <% } else { %>
                  <span class="badge bg-info text-dark">Verified</span>
                <% } %>
              </td>
              <td class="small text-muted">
                <%= new Date(item.createdAt).toLocaleDateString() %>
              </td>
              <td class="text-end">
                <a href="/admin/listings/review/<%= item._id %>" class="btn btn-sm btn-warning font-medium">
                  <i class="bi bi-eye-fill me-1"></i> Inspect & Review
                </a>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="admin-card p-5 text-center text-muted">
      <i class="bi bi-check-circle fs-1 text-warning d-block mb-3"></i>
      <h5>No listings in this queue</h5>
      <p class="small mb-0">All submitted garment listings have been reviewed.</p>
    </div>
  <% } %>

</body>
</html>
