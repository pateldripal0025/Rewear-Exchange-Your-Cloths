<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ReWear — Premium Sustainable Clothes Exchange</title>
    
    <!-- Meta SEO -->
    <meta name="description" content="Exchange luxury & high-end pre-loved fashion using ReWear's circular credit system. Join the sustainable fashion movement.">
    
    <!-- Google Fonts: Cormorant Garamond & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- ReWear Premium Design System CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="<%= (typeof currTheme !== 'undefined' && currTheme === 'light') ? 'light-mode' : '' %>">

    <% if(typeof hideNavbar === "undefined" || !hideNavbar){ %>
        <%- include("../includes/navbar.ejs") %>
    <% } %>

    <%- include("../includes/flash") %>

    <main class="content flex-grow-1">
        <%- body %>
    </main>

    <%- include("../includes/footer.ejs") %>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    
    <!-- GSAP & ScrollTrigger -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    
    <!-- Custom Application Scripts -->
    <script src="/js/style.js"></script>
    <script src="/js/animations.js"></script>

    <!-- Theme Switcher Script -->
    <script>
        const themeToggleBtn = document.getElementById('themeToggleBtn');
        const themeIcon = document.getElementById('themeIcon');
        
        function updateIcon(theme) {
            if (!themeIcon) return;
            if (theme === 'light') {
                themeIcon.className = 'bi bi-sun-fill';
            } else {
                themeIcon.className = 'bi bi-moon-stars-fill';
            }
        }

        if (themeToggleBtn) {
            updateIcon(document.body.classList.contains('light-mode') ? 'light' : 'dark');

            themeToggleBtn.addEventListener('click', () => {
                const isLight = document.body.classList.toggle('light-mode');
                const theme = isLight ? 'light' : 'dark';
                
                const d = new Date();
                d.setTime(d.getTime() + (365*24*60*60*1000));
                document.cookie = `theme=${theme};expires=${d.toUTCString()};path=/`;
                
                updateIcon(theme);
            });
        }
    </script>
</body>
</html>