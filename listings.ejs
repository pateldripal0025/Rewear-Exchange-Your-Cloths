<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Archive Listings — Admin Portal</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    
    <style>
        .admin-sidebar {
            width: 260px;
            min-height: 100vh;
            background: #0D0F12;
            border-right: 1px solid rgba(255, 255, 255, 0.08);
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
        }
        .admin-main {
            margin-left: 260px;
            min-height: 100vh;
            background: #0B0C0E;
        }
        .admin-nav-link {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            padding: 0.85rem 1.25rem;
            color: #A0A5B1;
            font-size: 0.88rem;
            font-weight: 500;
            border-radius: 8px;
            transition: all 0.25s ease;
            margin-bottom: 0.25rem;
        }
        .admin-nav-link:hover, .admin-nav-link.active {
            color: #D4AF37;
            background: rgba(212, 175, 55, 0.08);
        }
    </style>
</head>
<body class="<%= (typeof currTheme !== 'undefined' && currTheme === 'light') ? 'light-mode' : '' %>">

    <!-- Sidebar -->
    <aside class="admin-sidebar p-3 d-flex flex-column">
        <div class="d-flex align-items-center gap-2 px-2 py-3 mb-4 border-bottom border-secondary border-opacity-25">
            <i class="bi bi-shield-lock-fill text-warning fs-3"></i>
            <div>
                <h5 class="font-serif mb-0 text-white fw-bold">ReWear Admin</h5>
                <span class="small text-muted text-uppercase tracking-wider" style="font-size: 0.65rem;">Control Panel</span>
            </div>
        </div>

        <nav class="flex-grow-1">
            <a href="/admin/dashboard" class="admin-nav-link">
                <i class="bi bi-speedometer2"></i> Dashboard Overview
            </a>
            <a href="/admin/requests" class="admin-nav-link">
                <i class="bi bi-arrow-left-right"></i> Exchange Requests
            </a>
            <a href="/admin/users" class="admin-nav-link">
                <i class="bi bi-people"></i> Users Directory
            </a>
            <a href="/admin/listings" class="admin-nav-link active">
                <i class="bi bi-archive"></i> Archive Listings
            </a>
        </nav>

        <div class="pt-3 border-top border-secondary border-opacity-25">
            <a href="/listings" class="admin-nav-link text-white-50">
                <i class="bi bi-box-arrow-left"></i> Exit to ReWear
            </a>
        </div>
    </aside>

    <!-- Main Body -->
    <main class="admin-main p-4 p-lg-5">
        
        <!-- Header -->
        <div class="d-flex align-items-center justify-content-between pb-4 mb-4 border-bottom border-secondary border-opacity-25">
            <div>
                <span class="eyebrow"><i class="bi bi-archive me-1"></i> Inventory</span>
                <h1 class="font-serif text-white display-6 mb-0">Archive Listings Directory</h1>
            </div>
            <button id="adminThemeToggleBtn" class="rw-theme-btn" aria-label="Toggle Light/Dark Mode" title="Toggle Theme">
                <i id="adminThemeIcon" class="bi <%= (typeof currTheme !== 'undefined' && currTheme === 'light') ? 'bi-sun-fill' : 'bi-moon-stars-fill' %>"></i>
            </button>
        </div>

        <!-- Listings Table -->
        <div class="rw-form-card p-4">
            <% if(listings && listings.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                        <thead>
                            <tr class="text-uppercase text-muted small border-secondary">
                                <th>Item Preview</th>
                                <th>Brand</th>
                                <th>Type & Size</th>
                                <th>Owner</th>
                                <th>Credit Price</th>
                                <th>Availability</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for(let item of listings) { %>
                                <tr class="border-secondary border-opacity-25">
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="<%= item.image?.url || '/images/placeholder.jpg' %>" style="width: 44px; height: 44px; object-fit: cover;" class="rounded" alt="">
                                            <div class="fw-medium text-white"><%= item.productName %></div>
                                        </div>
                                    </td>
                                    <td><%= item.brand %></td>
                                    <td>
                                        <div><%= item.itemType %></div>
                                        <div class="small text-muted">Size: <%= item.size %></div>
                                    </td>
                                    <td>@<%= item.owner?.username || 'Unknown' %></td>
                                    <td><span class="fw-bold text-warning"><i class="bi bi-coin"></i> <%= item.price || 0 %> PTS</span></td>
                                    <td>
                                        <% if(item.exchangeAvailable !== false) { %>
                                            <span class="badge bg-success">Available</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary">Exchanged / Inactive</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <a href="/listings/<%= item._id %>" class="rw-btn rw-btn-outline rw-btn-sm py-1 px-3" target="_blank">View Item</a>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="text-center py-5">
                    <p class="text-muted">No listings found.</p>
                </div>
            <% } %>
        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const themeBtn = document.getElementById('adminThemeToggleBtn');
        const themeIcon = document.getElementById('adminThemeIcon');
        if (themeBtn) {
            themeBtn.addEventListener('click', () => {
                const isLight = document.body.classList.toggle('light-mode');
                const theme = isLight ? 'light' : 'dark';
                if (themeIcon) {
                    themeIcon.className = isLight ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
                }
                const d = new Date();
                d.setTime(d.getTime() + (365*24*60*60*1000));
                document.cookie = `theme=${theme};expires=${d.toUTCString()};path=/`;
            });
        }
    </script>
</body>
</html>
