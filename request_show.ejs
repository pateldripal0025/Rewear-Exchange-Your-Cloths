<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exchange Request Details — Admin Portal</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    
    <style>
        .admin-sidebar {
            width: 260px;
            min-height: 100vh;
            background: #0D0F12;
            border-right: 1px solid rgba(255, 255, 255, 0.08);
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
        }
        .admin-main {
            margin-left: 260px;
            min-height: 100vh;
            background: #0B0C0E;
        }
        .admin-nav-link {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            padding: 0.85rem 1.25rem;
            color: #A0A5B1;
            font-size: 0.88rem;
            font-weight: 500;
            border-radius: 8px;
            transition: all 0.25s ease;
            margin-bottom: 0.25rem;
        }
        .admin-nav-link:hover, .admin-nav-link.active {
            color: #D4AF37;
            background: rgba(212, 175, 55, 0.08);
        }
        .user-card-panel {
            background: #14161C;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 1.5rem;
        }
        .audit-chat-box {
            background: #121418;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            max-height: 380px;
            overflow-y: auto;
            padding: 1rem;
        }
    </style>
</head>
<body class="<%= (typeof currTheme !== 'undefined' && currTheme === 'light') ? 'light-mode' : '' %>">

    <!-- Sidebar -->
    <aside class="admin-sidebar p-3 d-flex flex-column">
        <div class="d-flex align-items-center gap-2 px-2 py-3 mb-4 border-bottom border-secondary border-opacity-25">
            <i class="bi bi-shield-lock-fill text-warning fs-3"></i>
            <div>
                <h5 class="font-serif mb-0 text-white fw-bold">ReWear Admin</h5>
                <span class="small text-muted text-uppercase tracking-wider" style="font-size: 0.65rem;">Control Panel</span>
            </div>
        </div>

        <nav class="flex-grow-1">
            <a href="/admin/dashboard" class="admin-nav-link">
                <i class="bi bi-speedometer2"></i> Dashboard Overview
            </a>
            <a href="/admin/requests" class="admin-nav-link active">
                <i class="bi bi-arrow-left-right"></i> Exchange Requests
            </a>
            <a href="/admin/users" class="admin-nav-link">
                <i class="bi bi-people"></i> Users Directory
            </a>
            <a href="/admin/listings" class="admin-nav-link">
                <i class="bi bi-archive"></i> Archive Listings
            </a>
        </nav>

        <div class="pt-3 border-top border-secondary border-opacity-25">
            <a href="/listings" class="admin-nav-link text-white-50">
                <i class="bi bi-box-arrow-left"></i> Exit to ReWear
            </a>
        </div>
    </aside>

    <!-- Main Body -->
    <main class="admin-main p-4 p-lg-5">
        
        <!-- Top Navigation -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <a href="/admin/requests" class="text-muted small text-decoration-none">
                <i class="bi bi-arrow-left me-1"></i> Back to Requests Queue
            </a>
            <button id="adminThemeToggleBtn" class="rw-theme-btn" aria-label="Toggle Light/Dark Mode" title="Toggle Theme">
                <i id="adminThemeIcon" class="bi <%= (typeof currTheme !== 'undefined' && currTheme === 'light') ? 'bi-sun-fill' : 'bi-moon-stars-fill' %>"></i>
            </button>
        </div>

        <!-- Header -->
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-4 mb-4 border-bottom border-secondary border-opacity-25 gap-3">
            <div>
                <span class="eyebrow"><i class="bi bi-file-earmark-text me-1"></i> Request Inspection</span>
                <h1 class="font-serif text-white display-6 mb-1">Exchange Request #<%= requestItem._id.toString().slice(-8) %></h1>
                <span class="small text-muted">Created: <%= new Date(requestItem.createdAt).toLocaleString() %></span>
            </div>

            <!-- Status Badge -->
            <div>
                <% if(requestItem.status === 'PENDING_ADMIN' || requestItem.status === 'PENDING_ADMIN_REVIEW' || requestItem.status === 'pending') { %>
                    <span class="rw-badge rw-badge-gold fs-6 px-3 py-2"><i class="bi bi-hourglass-split me-1"></i> Pending Admin Review</span>
                <% } else if(requestItem.status === 'ADMIN_APPROVED') { %>
                    <span class="badge bg-info text-dark fs-6 px-3 py-2"><i class="bi bi-chat-dots me-1"></i> Admin Approved (Chat Active)</span>
                <% } else if(requestItem.status === 'COMPLETED' || requestItem.status === 'accepted') { %>
                    <span class="badge bg-success fs-6 px-3 py-2"><i class="bi bi-check-circle-fill me-1"></i> Exchange Completed</span>
                <% } else if(requestItem.status === 'ADMIN_REJECTED') { %>
                    <span class="badge bg-danger fs-6 px-3 py-2"><i class="bi bi-x-circle-fill me-1"></i> Admin Rejected</span>
                <% } else { %>
                    <span class="badge bg-secondary fs-6 px-3 py-2"><i class="bi bi-slash-circle me-1"></i> <%= requestItem.status %></span>
                <% } %>
            </div>
        </div>

        <!-- Admin Action Banner (If Pending) -->
        <% if(requestItem.status === 'PENDING_ADMIN' || requestItem.status === 'PENDING_ADMIN_REVIEW' || requestItem.status === 'pending') { %>
            <div class="rw-form-card p-4 mb-5" style="border-left: 4px solid var(--rw-accent);">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                    <div>
                        <h4 class="font-serif text-white mb-1"><i class="bi bi-shield-exclamation text-warning me-2"></i> Admin Action Required</h4>
                        <p class="text-secondary small mb-0">Review this request before granting access to private communication and swap execution.</p>
                    </div>
                    <div class="d-flex gap-3">
                        <button type="button" class="rw-btn rw-btn-danger rw-btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal">
                            <i class="bi bi-x-circle me-1"></i> Reject Request
                        </button>
                        <button type="button" class="rw-btn rw-btn-accent rw-btn-sm" data-bs-toggle="modal" data-bs-target="#approveModal">
                            <i class="bi bi-check-circle me-1"></i> Approve Request
                        </button>
                    </div>
                </div>
            </div>
        <% } %>

        <div class="row g-4 mb-5">
            <!-- Left: Requested Item Card -->
            <div class="col-lg-5">
                <div class="rw-form-card p-4 h-100">
                    <span class="eyebrow">Item Information</span>
                    <h3 class="font-serif text-white h4 mb-3"><%= requestItem.listing?.productName || 'Listing Deleted' %></h3>
                    
                    <% if(requestItem.listing) { %>
                        <div class="rounded overflow-hidden mb-3" style="aspect-ratio: 4/3;">
                            <img src="<%= requestItem.listing.image?.url || '/images/placeholder.jpg' %>" class="w-100 h-100 object-fit-cover" alt="">
                        </div>
                        
                        <div class="d-flex justify-content-between py-2 border-bottom border-secondary border-opacity-25">
                            <span class="text-muted">Brand</span>
                            <span class="fw-medium text-white"><%= requestItem.listing.brand %></span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-secondary border-opacity-25">
                            <span class="text-muted">Item Type</span>
                            <span class="fw-medium text-white"><%= requestItem.listing.itemType %></span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-secondary border-opacity-25">
                            <span class="text-muted">Size</span>
                            <span class="fw-medium text-white"><%= requestItem.listing.size %></span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-secondary border-opacity-25">
                            <span class="text-muted">Condition</span>
                            <span class="fw-medium text-white"><%= requestItem.listing.condition %></span>
                        </div>
                        <div class="d-flex justify-content-between py-2 pt-3">
                            <span class="text-muted">Exchange Credit Value</span>
                            <span class="fw-bold fs-5 text-warning"><i class="bi bi-coin"></i> <%= requestItem.creditValue || requestItem.listing.price %> PTS</span>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Right: Requester & Owner Profiles -->
            <div class="col-lg-7">
                <div class="row g-4">
                    <!-- Requester (User A) -->
                    <div class="col-md-6">
                        <div class="user-card-panel h-100">
                            <span class="eyebrow text-info">Requester (User A)</span>
                            <h4 class="font-serif text-white mb-1">@<%= requestItem.sender?.username || 'Unknown' %></h4>
                            <p class="small text-muted mb-3"><%= requestItem.sender?.email %></p>
                            
                            <div class="bg-dark p-3 rounded mb-3 border border-secondary border-opacity-25">
                                <span class="small text-muted d-block mb-1">Current Points Balance</span>
                                <div class="fs-4 font-serif fw-bold text-warning"><%= requestItem.sender?.points || 0 %> PTS</div>
                            </div>

                            <div class="small">
                                <div class="text-muted mb-1">Decision Status:</div>
                                <span class="badge bg-secondary"><%= requestItem.senderDecision %></span>
                            </div>
                        </div>
                    </div>

                    <!-- Owner (User B) -->
                    <div class="col-md-6">
                        <div class="user-card-panel h-100">
                            <span class="eyebrow text-success">Listing Owner (User B)</span>
                            <h4 class="font-serif text-white mb-1">@<%= requestItem.receiver?.username || 'Unknown' %></h4>
                            <p class="small text-muted mb-3"><%= requestItem.receiver?.email %></p>
                            
                            <div class="bg-dark p-3 rounded mb-3 border border-secondary border-opacity-25">
                                <span class="small text-muted d-block mb-1">Current Points Balance</span>
                                <div class="fs-4 font-serif fw-bold text-warning"><%= requestItem.receiver?.points || 0 %> PTS</div>
                            </div>

                            <div class="small">
                                <div class="text-muted mb-1">Decision Status:</div>
                                <span class="badge bg-secondary"><%= requestItem.receiverDecision %></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Chat Audit Log -->
                <div class="user-card-panel mt-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h4 class="font-serif text-white h5 mb-0"><i class="bi bi-chat-left-text text-warning me-2"></i> Communication Audit Log</h4>
                        <span class="small text-muted"><%= messages.length %> Messages</span>
                    </div>

                    <div class="audit-chat-box">
                        <% if(messages && messages.length > 0) { %>
                            <% for(let msg of messages) { %>
                                <div class="mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="fw-semibold text-warning small">@<%= msg.sender?.username %></span>
                                        <span class="text-muted" style="font-size: 0.7rem;"><%= new Date(msg.createdAt).toLocaleTimeString() %></span>
                                    </div>
                                    <p class="small text-white-50 mb-0"><%= msg.text %></p>
                                </div>
                            <% } %>
                        <% } else { %>
                            <div class="text-center py-4 text-muted small">
                                <i class="bi bi-chat-square-dots fs-3 d-block mb-1"></i>
                                No chat messages exchanged yet.
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <!-- Approve Modal Confirmation -->
    <div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-secondary text-white">
                <form action="/admin/requests/<%= requestItem._id %>/review" method="POST">
                    <input type="hidden" name="action" value="APPROVE">
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title font-serif text-warning"><i class="bi bi-check-circle me-2"></i> Approve Exchange Request</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-secondary small mb-3">
                            Approving this request will create a private communication channel between <strong>@<%= requestItem.sender?.username %></strong> and <strong>@<%= requestItem.receiver?.username %></strong>. Both users will be notified.
                        </p>
                        <div class="mb-3">
                            <label class="rw-label">Admin Review Notes (Optional)</label>
                            <textarea name="adminNotes" class="rw-textarea" rows="3" placeholder="e.g. Verified authenticity and item availability."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="rw-btn rw-btn-outline rw-btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="rw-btn rw-btn-accent rw-btn-sm">Confirm Approval</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Reject Modal Confirmation -->
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-secondary text-white">
                <form action="/admin/requests/<%= requestItem._id %>/review" method="POST">
                    <input type="hidden" name="action" value="REJECT">
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title font-serif text-danger"><i class="bi bi-x-circle me-2"></i> Reject Exchange Request</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-secondary small mb-3">
                            Are you sure you want to reject this request? The exchange process will terminate immediately and no credits will be transferred.
                        </p>
                        <div class="mb-3">
                            <label class="rw-label">Rejection Rationale</label>
                            <textarea name="adminNotes" class="rw-textarea" rows="3" placeholder="e.g. Item does not meet ReWear condition guidelines." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="rw-btn rw-btn-outline rw-btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="rw-btn rw-btn-danger rw-btn-sm">Confirm Rejection</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const themeBtn = document.getElementById('adminThemeToggleBtn');
        const themeIcon = document.getElementById('adminThemeIcon');
        if (themeBtn) {
            themeBtn.addEventListener('click', () => {
                const isLight = document.body.classList.toggle('light-mode');
                const theme = isLight ? 'light' : 'dark';
                if (themeIcon) {
                    themeIcon.className = isLight ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
                }
                const d = new Date();
                d.setTime(d.getTime() + (365*24*60*60*1000));
                document.cookie = `theme=${theme};expires=${d.toUTCString()};path=/`;
            });
        }
    </script>
</body>
</html>
