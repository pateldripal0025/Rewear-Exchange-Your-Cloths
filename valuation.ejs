<% layout("/layouts/boilerplate") -%>

<div class="container px-4 px-lg-5 py-5">
    <div class="rw-form-card max-w-4xl mx-auto p-4 p-md-5">

        <!-- Status Header Banner -->
        <div class="p-4 rounded-4 mb-5 text-center position-relative overflow-hidden" 
             style="background: linear-gradient(135deg, rgba(225, 169, 60, 0.15) 0%, rgba(22, 25, 32, 0.95) 100%); border: 1px solid rgba(225, 169, 60, 0.3);">
            <div class="badge bg-warning text-dark font-sans px-3 py-2 text-uppercase mb-2" style="letter-spacing: 0.08em;">
                <i class="bi bi-clock-history me-1"></i> WAITING FOR ADMIN APPROVAL
            </div>
            <h2 class="font-serif display-6 mb-2">AI Product Evaluation Complete</h2>
            <p class="text-secondary mb-0 max-w-xl mx-auto" style="font-size: 0.95rem;">
                Your listing has been analyzed by ReWear AI Vision. It is currently queued for Admin Review and will appear in the main listings once approved.
            </p>
        </div>

        <div class="row g-4 mb-5">
            <!-- Left: 3 Compulsory Images Preview -->
            <div class="col-lg-6">
                <h5 class="font-serif mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-images text-warning"></i> Uploaded Verification Photos
                </h5>
                
                <div class="row g-2">
                    <!-- Front Image -->
                    <div class="col-6">
                        <div class="rounded-3 overflow-hidden border border-secondary border-opacity-25 position-relative shadow-sm" style="height: 180px;">
                            <img src="<%= listing.frontImage?.url || listing.image?.url %>" class="w-100 h-100 object-fit-cover">
                            <span class="position-absolute bottom-0 start-0 w-100 bg-dark bg-opacity-75 text-warning text-center py-1 fw-bold" style="font-size: 0.7rem;">FRONT PHOTO</span>
                        </div>
                    </div>

                    <!-- Back Image -->
                    <div class="col-6">
                        <div class="rounded-3 overflow-hidden border border-secondary border-opacity-25 position-relative shadow-sm" style="height: 180px;">
                            <img src="<%= listing.backImage?.url || listing.image?.url %>" class="w-100 h-100 object-fit-cover">
                            <span class="position-absolute bottom-0 start-0 w-100 bg-dark bg-opacity-75 text-warning text-center py-1 fw-bold" style="font-size: 0.7rem;">BACK PHOTO</span>
                        </div>
                    </div>

                    <!-- Label Image -->
                    <div class="col-12 mt-2">
                        <div class="rounded-3 overflow-hidden border border-secondary border-opacity-25 position-relative shadow-sm" style="height: 160px;">
                            <img src="<%= listing.labelImage?.url || listing.image?.url %>" class="w-100 h-100 object-fit-cover">
                            <span class="position-absolute bottom-0 start-0 w-100 bg-dark bg-opacity-75 text-warning text-center py-1 fw-bold" style="font-size: 0.7rem;">BRAND & SIZE LABEL PHOTO</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: AI Evaluation Results -->
            <div class="col-lg-6">
                <div class="bg-dark p-4 rounded-4 border border-secondary border-opacity-25 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom border-secondary border-opacity-25 pb-3">
                            <span class="eyebrow text-warning mb-0"><i class="bi bi-cpu me-1"></i> AI Vision Summary</span>
                            <span class="badge <%= listing.aiEvaluation?.confidence === 'High' ? 'bg-success' : 'bg-warning text-dark' %>">
                                Confidence: <%= listing.aiEvaluation?.confidence || 'Medium' %>
                            </span>
                        </div>

                        <h3 class="font-serif h4 mb-3"><%= listing.productName %></h3>

                        <!-- AI Detected Grid -->
                        <div class="row g-2 mb-4">
                            <div class="col-6">
                                <div class="p-2 rounded bg-body-tertiary border border-secondary border-opacity-10">
                                    <div class="small text-muted" style="font-size: 0.72rem;">DETECTED BRAND</div>
                                    <div class="fw-bold text-light"><%= listing.aiEvaluation?.detectedBrand || listing.brand %></div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 rounded bg-body-tertiary border border-secondary border-opacity-10">
                                    <div class="small text-muted" style="font-size: 0.72rem;">DETECTED SIZE</div>
                                    <div class="fw-bold text-light"><%= listing.aiEvaluation?.detectedSize || listing.size %></div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 rounded bg-body-tertiary border border-secondary border-opacity-10">
                                    <div class="small text-muted" style="font-size: 0.72rem;">EVALUATED CONDITION</div>
                                    <div class="fw-bold text-light"><%= listing.aiEvaluation?.detectedCondition || listing.condition %></div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 rounded bg-body-tertiary border border-secondary border-opacity-10">
                                    <div class="small text-muted" style="font-size: 0.72rem;">MATERIAL</div>
                                    <div class="fw-bold text-light"><%= listing.aiEvaluation?.detectedMaterial || listing.material || 'Cotton Blend' %></div>
                                </div>
                            </div>
                        </div>

                        <!-- Mismatch Warning Banner if detected -->
                        <% if(listing.aiEvaluation?.informationMismatch) { %>
                            <div class="alert alert-warning p-3 rounded-3 mb-4 small d-flex align-items-start gap-2">
                                <i class="bi bi-exclamation-triangle-fill fs-5 text-warning flex-shrink-0"></i>
                                <div>
                                    <strong>Information Mismatch Flagged:</strong>
                                    <%= listing.aiEvaluation?.detectedIssues?.join(', ') || 'Declared specs differ slightly from image label.' %>
                                </div>
                            </div>
                        <% } %>

                        <!-- Reasoning -->
                        <div class="mb-4">
                            <label class="small text-muted mb-1 font-serif">AI Valuation Reasoning:</label>
                            <p class="small text-secondary mb-0 fst-italic">
                                "<%= listing.aiEvaluation?.valuationReasoning || 'Valuation computed from second-hand market positioning, brand desirability, and garment condition.' %>"
                            </p>
                        </div>
                    </div>

                    <!-- AI Valuation Card -->
                    <div class="p-3 rounded-3 text-center" style="background: rgba(225, 169, 60, 0.1); border: 1px solid rgba(225, 169, 60, 0.3);">
                        <div class="row align-items-center">
                            <div class="col-6 border-end border-secondary border-opacity-25">
                                <div class="small text-muted mb-1" style="font-size: 0.75rem;">AI ESTIMATED REAL VALUE</div>
                                <div class="fs-4 fw-bold text-warning">₹<%= (listing.aiEvaluation?.estimatedValueINR || listing.price || 0).toLocaleString() %></div>
                            </div>
                            <div class="col-6">
                                <div class="small text-muted mb-1" style="font-size: 0.75rem;">REWEAR CREDIT VALUE</div>
                                <div class="fs-4 fw-bold text-success"><%= (listing.aiEvaluation?.suggestedCredits || listing.price || 0).toLocaleString() %> CREDITS</div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Action Footer -->
        <div class="border-top border-secondary border-opacity-25 pt-4 d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3">
            <a href="/dashboard" class="rw-btn rw-btn-outline">
                <i class="bi bi-speedometer2 me-1"></i> Go to Seller Dashboard
            </a>
            <div class="small text-muted text-center text-sm-end">
                <i class="bi bi-shield-lock me-1 text-warning"></i> ReWear Admin will review and authorize final credits within 24 hours.
            </div>
        </div>

    </div>
</div>
